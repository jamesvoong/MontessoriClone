---
// Footer.astro
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">

      <!-- Brand -->
      <div class="footer__brand">
        <p class="footer__brand-name">🌳 Monkey Tree Montessori</p>
        <p class="footer__tagline">A nurturing environment where children learn at their own pace.</p>
        <div class="footer__contact-item">
          <span>📞</span>
          <a href="tel:6046778339">604-677-8339</a>
        </div>
        <div class="footer__contact-item">
          <span>✉️</span>
          <a href="mailto:Montessori.monkeytree@gmail.com">Montessori.monkeytree@gmail.com</a>
        </div>
        <div class="footer__contact-item">
          <span>📸</span>
          <a href="https://www.instagram.com/monkeytreepreschool" target="_blank" rel="noopener noreferrer">@monkeytreepreschool</a>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="footer__col">
        <h4>Quick Links</h4>
        <nav class="footer__links">
          <a href="/">Home</a>
          <a href="/curriculum">Curriculum</a>
          <a href="/maria-montessori">About Maria Montessori</a>
          <a href="/registration">Class Times &amp; Registration</a>
          <a href="/contact">Contact Us</a>
        </nav>
      </div>

      <!-- Hours -->
      <div class="footer__col">
        <h4>School Hours</h4>
        <div style="font-size:0.88rem; color: rgba(255,255,255,0.65); line-height:1.8;">
          <p style="margin-bottom:0.25rem; max-width:none;">
            <strong style="color:rgba(255,255,255,0.85);">Morning Class</strong><br>
            Mon–Fri · 8:30 am – 11:30 am
          </p>
          <p style="margin-bottom:0.25rem; max-width:none;">
            <strong style="color:rgba(255,255,255,0.85);">Afternoon Class</strong><br>
            Mon–Fri · 12:30 pm – 3:30 pm
          </p>
          <p style="margin-bottom:0; max-width:none; margin-top:0.75rem;">
            <strong style="color:rgba(255,255,255,0.85);">Office</strong><br>
            Mon–Fri · 8:00 am – 4:00 pm
          </p>
        </div>
      </div>

    </div>

    <div class="footer__bottom">
      <span>© 2024 Monkey Tree Montessori Preschool Inc. All rights reserved.</span>
      <span>Ages 2½ – 6 · Vancouver, BC</span>
    </div>
  </div>
</footer>
